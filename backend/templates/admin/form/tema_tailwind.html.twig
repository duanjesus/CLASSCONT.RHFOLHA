{#
 # Tema de formulário (form theme) do painel.
 # Estende o layout padrão do Symfony e sobrescreve só os blocos necessários
 # para aplicar as classes do Tailwind. Registrado em config/packages/twig.yaml.
 #}
{% extends 'form_div_layout.html.twig' %}

{%- block form_row -%}
    {%- set widget_attr = {} -%}
    {%- if help is not empty -%}
        {%- set widget_attr = {attr: {'aria-describedby': id ~ '_help'}} -%}
    {%- endif -%}
    <div class="mb-5">
        {{- form_label(form) -}}
        {{- form_widget(form, widget_attr) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock form_row -%}

{%- block form_label -%}
    {%- set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' rotulo')|trim}) -%}
    {{- parent() -}}
{%- endblock form_label -%}

{# Asterisco nos obrigatórios #}
{%- block form_label_content -%}
    {{- parent() -}}
    {%- if required -%}<span class="text-red-500" aria-hidden="true"> *</span>{%- endif -%}
{%- endblock form_label_content -%}

{%- block form_widget_simple -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' campo' ~ (errors|length ? ' campo-erro' : ''))|trim}) -%}
    {{- parent() -}}
{%- endblock form_widget_simple -%}

{%- block textarea_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' campo')|trim, rows: attr.rows|default(4)}) -%}
    {{- parent() -}}
{%- endblock textarea_widget -%}

{%- block choice_widget_collapsed -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' campo' ~ (errors|length ? ' campo-erro' : ''))|trim}) -%}
    {{- parent() -}}
{%- endblock choice_widget_collapsed -%}

{# MoneyType: "R$" como prefixo visual dentro do campo #}
{%- block money_widget -%}
    <div class="relative">
        <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-sm text-slate-500">R$</span>
        {%- set attr = attr|merge({class: (attr.class|default('') ~ ' pl-10')|trim}) -%}
        {{- block('form_widget_simple') -}}
    </div>
{%- endblock money_widget -%}

{%- block checkbox_row -%}
    <div class="mb-5">
        <label class="flex items-start gap-3" for="{{ id }}">
            {{- form_widget(form) -}}
            <span>
                <span class="block text-sm font-medium text-slate-700">{{ label|trans({}, translation_domain) }}</span>
                {%- if help is not empty -%}<span class="block text-xs text-slate-500">{{ help|trans({}, translation_domain) }}</span>{%- endif -%}
            </span>
        </label>
        {{- form_errors(form) -}}
    </div>
{%- endblock checkbox_row -%}

{%- block checkbox_widget -%}
    {%- set attr = attr|merge({class: 'mt-0.5 h-4 w-4 rounded border-slate-300 text-marca-700 focus:ring-marca-500'}) -%}
    {{- parent() -}}
{%- endblock checkbox_widget -%}

{%- block form_help -%}
    {%- if help is not empty -%}
        <p id="{{ id }}_help" class="mt-1 text-xs text-slate-500">{{ help|trans(help_translation_parameters, translation_domain) }}</p>
    {%- endif -%}
{%- endblock form_help -%}

{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        {%- for error in errors -%}
            <p class="mt-1 text-sm text-red-600">{{ error.message }}</p>
        {%- endfor -%}
    {%- endif -%}
{%- endblock form_errors -%}
