{#
 # Formulário genérico de criação/edição, reaproveitado por todos os CRUDs.
 # Recebe: titulo, form (FormView) e voltar (nome da rota da listagem).
 #}
{% extends 'admin/layout.html.twig' %}
{% import 'admin/_macros.html.twig' as ui %}

{% block title %}{{ titulo }}{% endblock %}

{% block conteudo %}
    <a href="{{ path(voltar) }}" class="btn-link mb-4 inline-block">&larr; Voltar para a listagem</a>
    {{ ui.cabecalho(titulo) }}

    <div class="cartao max-w-2xl p-6">
        {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
            {{ form_errors(form) }}
            {{ form_rest(form) }}
            <div class="mt-6 flex gap-3 border-t border-slate-100 pt-6">
                <button type="submit" class="btn btn-primario">Salvar</button>
                <a href="{{ path(voltar) }}" class="btn btn-secundario">Cancelar</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
