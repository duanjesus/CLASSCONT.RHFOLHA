{% extends 'base.html.twig' %}

{#
 # Layout do painel do RH. As páginas estendem este arquivo e preenchem o bloco "conteudo".
 # O menu é uma estrutura de dados percorrida com for — mais fácil de manter que HTML repetido.
 #}
{% set menu = [
    {secao: 'Visão geral', itens: [
        {rota: 'admin_dashboard', rotulo: 'Início', icone: 'M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1v-9.5Z'},
    ]},
    {secao: 'Cadastros', itens: [
        {rota: 'admin_funcionarios', rotulo: 'Funcionários', icone: 'M16 19a4 4 0 0 0-8 0M12 12a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm7 7a3 3 0 0 0-3-3m0-6a2.5 2.5 0 1 0 0-5'},
        {rota: 'admin_setores', rotulo: 'Setores', icone: 'M4 21V5a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v16M14 9h5a1 1 0 0 1 1 1v11M8 8h2M8 12h2M8 16h2'},
        {rota: 'admin_cargos', rotulo: 'Cargos', icone: 'M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M4 7h16v12a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7Z'},
        {rota: 'admin_feriados', rotulo: 'Feriados', icone: 'M7 3v3M17 3v3M4 8h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z'},
        {rota: 'admin_linhas', rotulo: 'Linhas de ônibus', icone: 'M6 17h12M6 17v2M18 17v2M5 4h14a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1ZM4 11h16'},
    ]},
    {secao: 'Folha', itens: [
        {rota: 'admin_fechamentos', rotulo: 'Fechamento mensal', icone: 'M8 11V7a4 4 0 1 1 8 0v4M6 11h12a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-8a1 1 0 0 1 1-1Z'},
        {rota: 'admin_relatorio_auxilio', rotulo: 'Auxílio-transporte', icone: 'M4 19h16M7 15V9M12 15V5M17 15v-4'},
    ]},
    {secao: 'Controle', itens: [
        {rota: 'admin_auditoria', rotulo: 'Auditoria', icone: 'M12 3 4 6v5c0 5 3.4 8.6 8 10 4.6-1.4 8-5 8-10V6l-8-3Zm-3 9 2 2 4-4'},
    ]},
] %}
{% set rota_atual = app.request.attributes.get('_route') %}

{% block body %}
<div class="min-h-full lg:flex">
    <aside class="bg-marca-900 text-marca-100 lg:fixed lg:inset-y-0 lg:flex lg:w-64 lg:flex-col">
        <div class="flex h-16 items-center gap-3 px-6">
            <span class="grid h-9 w-9 place-items-center rounded-lg bg-marca-700 font-bold text-destaque">RH</span>
            <div class="leading-tight">
                <div class="text-sm font-semibold text-white">CLASSCONT</div>
                <div class="text-xs text-marca-100/70">RHFOLHA · Painel do RH</div>
            </div>
        </div>
        <nav class="flex gap-6 overflow-x-auto px-4 pb-4 lg:flex-1 lg:flex-col lg:overflow-y-auto">
            {% for grupo in menu %}
                <div>
                    <p class="mb-2 hidden px-2 text-xs font-semibold uppercase tracking-wider text-marca-100/50 lg:block">{{ grupo.secao }}</p>
                    <ul class="flex gap-1 lg:flex-col">
                        {% for item in grupo.itens %}
                            {% set ativo = rota_atual starts with item.rota %}
                            <li>
                                <a href="{{ path(item.rota) }}"
                                   class="flex items-center gap-3 whitespace-nowrap rounded-lg px-3 py-2 text-sm {{ ativo ? 'bg-marca-700 text-white' : 'hover:bg-marca-700/50 hover:text-white' }}"
                                   {% if ativo %}aria-current="page"{% endif %}>
                                    <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="{{ item.icone }}"/></svg>
                                    {{ item.rotulo }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endfor %}
        </nav>
        <div class="hidden border-t border-marca-700 px-6 py-4 text-sm lg:block">
            <p class="font-medium text-white">{{ app.user.nome }}</p>
            <p class="text-xs text-marca-100/70">{{ app.user.setor.sigla }} · {{ app.user.cargo }}</p>
            <a href="{{ path('admin_logout') }}" class="mt-2 inline-block text-xs text-destaque hover:underline">Sair</a>
        </div>
    </aside>

    <main class="min-w-0 flex-1 lg:pl-64">
        <div class="mx-auto max-w-6xl px-4 py-8 sm:px-8">
            {# Flash messages: tipos "sucesso" e "erro" #}
            {% for tipo, mensagens in app.flashes %}
                {% for mensagem in mensagens %}
                    <div role="status" class="mb-4 rounded-lg border px-4 py-3 text-sm {{ tipo == 'erro' ? 'border-red-200 bg-red-50 text-red-800' : 'border-emerald-200 bg-emerald-50 text-emerald-800' }}">
                        {{ mensagem }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% block conteudo %}{% endblock %}
        </div>
    </main>
</div>
{% endblock %}
