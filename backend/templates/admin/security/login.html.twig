{% extends 'base.html.twig' %}

{% block title %}Entrar{% endblock %}

{% block body %}
<div class="flex min-h-full items-center justify-center bg-gradient-to-br from-marca-900 to-marca-700 px-4 py-12">
    <div class="w-full max-w-sm">
        <div class="mb-8 text-center text-white">
            <span class="mx-auto grid h-12 w-12 place-items-center rounded-xl bg-white/10 text-lg font-bold text-destaque">RH</span>
            <h1 class="mt-4 text-2xl font-semibold">Painel do RH</h1>
            <p class="mt-1 text-sm text-marca-100/80">CLASSCONT.RHFOLHA</p>
        </div>

        <form method="post" class="cartao p-6">
            {% if erro %}
                <div class="mb-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700">
                    {{ erro.messageKey|trans(erro.messageData, 'security') }}
                </div>
            {% endif %}

            <label for="email" class="rotulo">E-mail</label>
            <input type="email" id="email" name="email" value="{{ ultimo_email }}" class="campo mb-4" autocomplete="email" required autofocus>

            <label for="senha" class="rotulo">Senha</label>
            <input type="password" id="senha" name="senha" class="campo mb-6" autocomplete="current-password" required>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="btn btn-primario w-full">Entrar</button>
            <p class="mt-4 text-center text-xs text-slate-500">Acesso restrito a servidores do RH.</p>
        </form>
    </div>
</div>
{% endblock %}
