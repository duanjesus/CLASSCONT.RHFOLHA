{#
 # E-mail transacional (TemplatedEmail). Clientes de e-mail exigem HTML simples
 # com estilos inline — por isso não usa o layout do painel.
 #}
{% set aprovado = status.value == 'APROVADA' %}
<!DOCTYPE html>
<html lang="pt-BR">
<body style="margin:0;padding:24px;background:#f1f5f9;font-family:Arial,Helvetica,sans-serif;color:#1e293b;">
    <table role="presentation" width="100%" style="max-width:560px;margin:0 auto;background:#ffffff;border-radius:12px;overflow:hidden;">
        <tr>
            <td style="background:#1e3a5f;padding:20px 28px;color:#ffffff;">
                <strong style="font-size:16px;">CLASSCONT.RHFOLHA</strong><br>
                <span style="font-size:12px;opacity:.8;">Gestão de Pessoal</span>
            </td>
        </tr>
        <tr>
            <td style="padding:28px;">
                <p style="margin:0 0 16px;">Olá, {{ destinatario.nome|split(' ')|first }}.</p>
                <p style="margin:0 0 16px;">Seu pedido foi avaliado:</p>

                <table role="presentation" width="100%" style="border:1px solid #e2e8f0;border-radius:8px;">
                    <tr><td style="padding:14px 16px;">
                        <div style="font-size:13px;color:#64748b;">{{ descricao_pedido }}</div>
                        <div style="margin-top:6px;font-size:18px;font-weight:bold;color:{{ aprovado ? '#047857' : '#dc2626' }};">
                            {{ aprovado ? '✔' : '✖' }} {{ status.label }}
                        </div>
                        <div style="margin-top:6px;font-size:13px;color:#64748b;">por {{ avaliador.nome }}</div>
                    </td></tr>
                </table>

                {% if observacao %}
                    <p style="margin:16px 0 0;padding:12px 16px;background:#f8fafc;border-left:3px solid #94a3b8;font-size:14px;">
                        “{{ observacao }}”
                    </p>
                {% endif %}

                <p style="margin:24px 0 0;font-size:12px;color:#94a3b8;">Mensagem automática — não responda este e-mail.</p>
            </td>
        </tr>
    </table>
</body>
</html>
